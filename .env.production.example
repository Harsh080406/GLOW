# ==============================================================================
# GLOW Smart Campus Bus Transit - Production Environment Template (.env.example)
# ==============================================================================

NODE_ENV=production
PORT=5000
FRONTEND_ORIGIN=https://glow.gsfcuniversity.ac.in

# MongoDB with Replica Set for Transaction Support
MONGODB_URI=mongodb://mongo:27017/glow_transit?replicaSet=rs0

# Cryptographic Keys
JWT_SECRET=your_super_secret_64_character_jwt_access_key
JWT_REFRESH_SECRET=your_super_secret_64_character_jwt_refresh_key
PASS_HMAC_SECRET=your_hmac_secret_for_pass_validation
RECEIPT_HMAC_SECRET=your_hmac_secret_for_receipt_validation

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://glow.gsfcuniversity.ac.in/api/v1/auth/google/callback

# SMS Gateway Providers (Twilio / MSG91 / Fast2SMS)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+18005550199

# Email Providers (SendGrid / SMTP / Resend / AWS SES)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key
EMAIL_FROM_ADDRESS=transit@gsfcuniversity.ac.in
EMAIL_FROM_NAME="GSFC University Campus Transit"

# Telemetry
GPS_SIMULATOR_ENABLED=true
GPS_POLL_INTERVAL_MS=4000
