{
  "name": "glow-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "node start.js",
    "dev": "node start.js",
    "dev:all": "node start.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "server": "npm --prefix backend run dev",
    "client": "npm --prefix frontend run dev",
    "db:seed": "npm --prefix backend run db:seed",
    "postinstall": "npm --prefix frontend install",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint"
  },
  "dependencies": {
    "mongodb": "^7.6.0"
  }
}
